{
  "name": "dashboard-colegio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api": "node --env-file-if-exists=.env --watch server/index.ts",
    "vite": "vite",
    "dev": "concurrently -k -n api,vite \"npm:api\" \"npm:vite\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "lint": "oxlint",
    "db:init": "node --env-file-if-exists=.env server/db/init.ts",
    "backup": "node --env-file-if-exists=.env server/db/backup.ts",
    "backup:restore": "node --env-file-if-exists=.env server/db/backup.ts restore",
    "test:smoke": "node --env-file-if-exists=.env server/test/smoke.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.79.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
