# Variables de entorno del dashboard colegio.
# Opcional: si sólo se usa el proyecto en desarrollo, este archivo no es necesario.
# Copiar a `.env` y ajustar por entorno. Los secretos NUNCA van al repositorio.

# Puerto HTTP de la API (defecto: 8787)
PORT=8787

# Ruta de la base SQLite (defecto: server/data/colegio.db).
# Útil para entornos de prueba o por instancia.
# DATABASE_PATH=server/data/colegio.db

# Duración de la sesión en horas (defecto: 8).
# SESION_EXPIRACION_HORAS=8

# Directorio de respaldos (defecto: server/data/backups).
# BACKUPS_DIR=server/data/backups